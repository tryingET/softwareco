# softwareco ROCS settings, sourced by scripts/rocs.sh (POSIX sh, `set -a`, launcher
# args in "$@", launcher repo root in "$repo"). See docs/dev/l1-local-extensions.md.
#
# Parent-owned ROCS outputs must never be generated beneath the ontology owner gitlink,
# and the launcher may only target the Softwareco parent (f950a4e).
softwareco_output_root="governance/ontology-dist"
if [ "${ROCS_OUTPUT_ROOT:-$softwareco_output_root}" != "$softwareco_output_root" ]; then
  echo "error: ROCS_OUTPUT_ROOT must be $softwareco_output_root for the Softwareco parent" >&2
  exit 2
fi
ROCS_OUTPUT_ROOT="$softwareco_output_root"
ROCS_AUTHORITY_AGGREGATE=1
: "${ROCS_CI_PROFILE:=main-strict}"
PYTHONDONTWRITEBYTECODE=1

softwareco_parent="$(CDPATH='' cd -- "$repo" && pwd -P)"
if [ -n "${ROCS_REPO:-}" ] && [ "$(CDPATH='' cd -- "$ROCS_REPO" 2>/dev/null && pwd -P)" != "$softwareco_parent" ]; then
  echo "error: ROCS_REPO must be the Softwareco parent: $softwareco_parent" >&2
  exit 2
fi
ROCS_REPO="$softwareco_parent"
softwareco_previous=""
for softwareco_arg in "$@"; do
  softwareco_candidate=""
  if [ "$softwareco_previous" = "--repo" ]; then
    softwareco_candidate="$softwareco_arg"
  fi
  case "$softwareco_arg" in
    --repo=*) softwareco_candidate="${softwareco_arg#--repo=}" ;;
  esac
  if [ -n "$softwareco_candidate" ]; then
    softwareco_resolved="$(CDPATH='' cd -- "$softwareco_candidate" 2>/dev/null && pwd -P)" || {
      echo "error: --repo is not a readable directory: $softwareco_candidate" >&2
      exit 2
    }
    if [ "$softwareco_resolved" != "$softwareco_parent" ]; then
      echo "error: --repo must be the Softwareco parent: $softwareco_parent" >&2
      exit 2
    fi
  fi
  softwareco_previous="$softwareco_arg"
done
if [ "$softwareco_previous" = "--repo" ]; then
  echo "error: --repo requires the Softwareco parent path" >&2
  exit 2
fi
unset softwareco_output_root softwareco_parent softwareco_previous softwareco_arg softwareco_candidate softwareco_resolved
