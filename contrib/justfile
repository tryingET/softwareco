# Run `just` to see available recipes.

default: help

help:
    @echo "Recipes:"
    @echo "  just ensure-defaults      # clone required repos if missing"
    @echo "  just clone-if-missing URL # clone one repo if missing"
    @echo "  just pull-all             # pull latest in all first-level clean git dirs"
    @echo "  just sync                 # ensure defaults, then pull-all"

clone-if-missing repo_url:
    #!/usr/bin/env bash
    set -euo pipefail
    url="{{repo_url}}"
    repo="$(basename "${url%/}" .git)"

    if [[ -d "$repo/.git" ]]; then
      echo "exists:$repo"
    elif [[ -e "$repo" ]]; then
      echo "skip_exists_not_git:$repo"
    else
      git clone "$url"
      echo "cloned:$repo"
    fi

ensure-defaults:
    #!/usr/bin/env bash
    set -euo pipefail

    repos=(
      "https://github.com/MaximeRivest/dspy-template-adapter"
      "https://github.com/rawwerks/ypi"
      "https://github.com/zsviczian/obsidian-excalidraw-plugin"
    )

    for url in "${repos[@]}"; do
      repo="$(basename "${url%/}" .git)"
      if [[ -d "$repo/.git" ]]; then
        echo "exists:$repo"
      elif [[ -e "$repo" ]]; then
        echo "skip_exists_not_git:$repo"
      else
        git clone "$url"
        echo "cloned:$repo"
      fi
    done

pull-all:
    #!/usr/bin/env bash
    set -euo pipefail
    shopt -s nullglob

    updated=0
    up_to_date=0
    failed=0
    non_git=0
    dirty=0
    failed_repos=()

    for d in */; do
      repo="${d%/}"

      if [[ ! -d "$repo/.git" ]]; then
        ((non_git+=1))
        echo "skip_non_git:$repo"
        continue
      fi

      if [[ -n "$(git -C "$repo" status --porcelain)" ]]; then
        ((dirty+=1))
        echo "skip_dirty:$repo"
        continue
      fi

      before="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"

      if output="$(git -C "$repo" pull --ff-only 2>&1)"; then
        after="$(git -C "$repo" rev-parse HEAD 2>/dev/null || true)"
        if [[ "$before" != "$after" ]]; then
          ((updated+=1))
          echo "updated:$repo"
        else
          ((up_to_date+=1))
          echo "up_to_date:$repo"
        fi
      else
        ((failed+=1))
        failed_repos+=("$repo")
        echo "failed:$repo"
        while IFS= read -r line; do
          echo "  $line"
        done <<< "$output"
      fi
    done

    echo "summary updated=$updated up_to_date=$up_to_date failed=$failed dirty=$dirty non_git=$non_git"

    if ((failed > 0)); then
      echo "failed_repos:"
      for repo in "${failed_repos[@]}"; do
        echo "  $repo"
      done
      exit 1
    fi

sync:
    @just ensure-defaults
    @just pull-all
