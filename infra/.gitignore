# Local artifacts
.tmp/
tmp/
.candidate-worktrees/
*.tmp
*.log

# Python generated artifacts
__pycache__/
*.pyc

# Migration snapshots
.migration-backup/

# Child repositories in this lane root
# Keep the infra lane baseline tracked while ignoring nested child repos by default.
*
