!.copier-answers.yml
!AGENTS.md
!CODEOWNERS
!README.md
!next_session_prompt.md
!diary/
!diary/**
!docs/
!docs/**
!governance/
!governance/**
!ontology/
!ontology/**
!policy/
!policy/**
!scripts/
!scripts/**
!src/
!src/**
!tests/
!tests/**
!tools/
!tools/**

# Promote the tracker migration repo into lane visibility so it can be packaged and committed.
!issue-tracker/
!issue-tracker/**
