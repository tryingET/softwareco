[Unit]
Description=Softwareco observational CTO canary (one fresh proposal-only cycle)
Documentation=file://@ROOT@/docs/project/2026-07-26-softwareco-autonomous-cto-canary-handoff.md
ConditionPathExists=%S/softwareco-cto-canary/activation.json

[Service]
Type=oneshot
WorkingDirectory=@ROOT@
ExecStart=/usr/bin/python3 @BUNDLE_DIR@/run_cycle.py --state-dir %S/softwareco-cto-canary --activation-file %S/softwareco-cto-canary/activation.json --timeout 1800
StateDirectory=softwareco-cto-canary
RuntimeDirectory=softwareco-cto-canary
Environment=TMPDIR=%t/softwareco-cto-canary
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=@ROOT@
BindReadOnlyPaths=@BUNDLE_DIR@
BindReadOnlyPaths=%h/ai-society/society.v2.db
BindReadOnlyPaths=%h/.pi/agent/auth.json
BindReadOnlyPaths=%h/.pi/agent/settings.json
BindReadOnlyPaths=%h/.pi/agent/models.json
BindReadOnlyPaths=%h/.pi/agent/models-store.json
BindReadOnlyPaths=%h/.pi/agent/AGENTS.md
BindReadOnlyPaths=%h/.pi/agent/APPEND_SYSTEM.md
BindReadOnlyPaths=%h/.local/bin/ak
BindReadOnlyPaths=%h/.local/libexec/agent-kernel
ReadWritePaths=%S/softwareco-cto-canary %t/softwareco-cto-canary
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
KillMode=control-group
TimeoutStartSec=31min
