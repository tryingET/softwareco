{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Softwareco CTO canary proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification", "authority_claimed", "attempted_effects", "coverage", "observations", "drift_blockers", "theses", "drafts", "escalation", "uncertainty"],
  "properties": {
    "schema_version": {"const": 1},
    "classification": {"const": "proposal_only"},
    "authority_claimed": {"const": false},
    "attempted_effects": {"type": "array", "maxItems": 0},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "registered_repos_expected", "registered_repos_observed", "gaps"],
      "properties": {
        "complete": {"type": "boolean"},
        "registered_repos_expected": {"type": "integer", "minimum": 0},
        "registered_repos_observed": {"type": "integer", "minimum": 0},
        "gaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "observations": {"type": "array", "items": {"$ref": "#/$defs/evidenced"}},
    "drift_blockers": {"type": "array", "items": {"$ref": "#/$defs/evidenced"}},
    "theses": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["rank", "thesis", "evidence_refs", "inference", "displaced_options"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "thesis": {"type": "string", "minLength": 1},
          "evidence_refs": {"$ref": "#/$defs/refs"},
          "inference": {"type": "string"},
          "displaced_options": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "drafts": {
      "type": "object", "additionalProperties": false,
      "required": ["ak_tasks", "owner_envelopes", "decision_commands", "recommendations"],
      "properties": {
        "ak_tasks": {"type": "array", "items": {"type": "string"}},
        "owner_envelopes": {"type": "array", "items": {"type": "string"}},
        "decision_commands": {"type": "array", "items": {"type": "string"}},
        "recommendations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "escalation": {
      "type": "object", "additionalProperties": false,
      "required": ["recommendation", "rationale", "self_dispatched"],
      "properties": {
        "recommendation": {"enum": ["ordinary_bounded_task", "deep_review", "visible_loop", "nexus_coordination", "transcendent_iteration", "none"]},
        "rationale": {"type": "string"},
        "self_dispatched": {"const": false}
      }
    },
    "uncertainty": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^snapshot://"}},
    "evidenced": {
      "type": "object", "additionalProperties": false,
      "required": ["claim", "evidence_refs"],
      "properties": {"claim": {"type": "string", "minLength": 1}, "evidence_refs": {"$ref": "#/$defs/refs"}}
    }
  }
}
